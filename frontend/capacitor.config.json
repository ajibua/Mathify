{
  "appId": "com.aliyudavid.mathify",
  "appName": "Mathify",
  "webDir": "dist",
  "server": {
    "url": "https://mathify-coral.vercel.app",
    "cleartext": false,
    "allowNavigation": ["mathify-coral.vercel.app", "mathify-backend-one.vercel.app"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0E0E11",
      "showSpinner": false
    }
  }
}